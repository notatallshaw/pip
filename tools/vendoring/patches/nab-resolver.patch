@@ -0,0 +1,64 @@
+"""Rank resolution decisions using conflict and culprit evidence."""
+
+from __future__ import annotations
+
+from typing import TYPE_CHECKING
+
+if TYPE_CHECKING:
+    from collections.abc import Mapping
+
+    from .types import PackageType
+
+__all__ = [
+    "CONFLICT_THRESHOLD",
+    "CULPRIT_DEMOTE_THRESHOLD",
+    "TIER_AFFECTED",
+    "TIER_CULPRIT",
+    "TIER_NORMAL",
+    "compute_tier",
+    "is_dominant_culprit",
+]
+
+
+CONFLICT_THRESHOLD = 5
+
+# Minimum culprit count and lead required for count-based demotion.
+CULPRIT_DEMOTE_THRESHOLD = 5
