+        if left_upper < right_upper:
+            left_index += 1
+        else:
+            right_index += 1
+
+    if matched == len(left):
+        return _EMPTY_REL if disjoint else _SUBSET_REL
+    return _DISJOINT_REL if disjoint else _OVERLAPPING_REL
